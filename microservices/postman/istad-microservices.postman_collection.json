      "name": "3. Product Service (REST API)",
      "item": [
        {
          "name": "3.1 Create Product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var skuNum = Math.floor(Math.random() * 10000);",
                  "pm.variables.set(\"genSku\", \"SKU-PM-\" + skuNum);"
