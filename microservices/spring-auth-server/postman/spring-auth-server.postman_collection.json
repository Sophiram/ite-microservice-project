    {
      "name": "0 - Discovery (no auth)",
      "item": [
        {
          "name": "0.1 OIDC discovery",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/.well-known/openid-configuration",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ".well-known",
                "openid-configuration"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"issuer matches baseUrl\", () => pm.expect(j.issuer).to.eql(pm.environment.get(\"baseUrl\")));",
                  "pm.test(\"has token + authorize endpoints\", () => {",
                  "  pm.expect(j.token_endpoint).to.be.a(\"string\");",
                  "  pm.expect(j.authorization_endpoint).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
