    {
      "name": "3 - Authorization Code + PKCE (manual, step by step)",
      "description": "3.1 generates the PKCE values and the authorize URL. Open {{authorize_url}} in a browser, log in, copy the 'code' query parameter from the final redirect URL into the auth_code environment variable, then run 3.2 within 5 minutes.",
      "item": [
        {
          "name": "3.1 Generate PKCE + authorize URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/.well-known/openid-configuration",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ".well-known",
                "openid-configuration"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "After sending, open the environment quick-look (eye icon) and copy authorize_url into a browser."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate PKCE code_verifier / code_challenge (S256) and build the authorize URL",
                  "const b64url = (s) => s.replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "const verifier = b64url(CryptoJS.lib.WordArray.random(32).toString(CryptoJS.enc.Base64));",
                  "const challenge = b64url(CryptoJS.SHA256(verifier).toString(CryptoJS.enc.Base64));",
                  "pm.environment.set('code_verifier', verifier);",
                  "pm.environment.set('code_challenge', challenge);",
                  "const q = [",
                  "  'response_type=code',",
                  "  'client_id=' + encodeURIComponent(pm.environment.get('postman_client_id')),",
                  "  'scope=' + encodeURIComponent('openid profile api.read api.write'),",
                  "  'redirect_uri=' + encodeURIComponent(pm.environment.get('redirect_uri')),",
                  "  'state=manual-flow',",
                  "  'code_challenge=' + challenge,",
                  "  'code_challenge_method=S256'",
                  "].join('&');",
                  "pm.environment.set('authorize_url', pm.environment.get('baseUrl') + '/oauth2/authorize?' + q);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log(\"OPEN THIS URL IN A BROWSER:\\n\" + pm.environment.get(\"authorize_url\"));",
                  "pm.test(\"authorize_url created\", () => pm.expect(pm.environment.get(\"authorize_url\")).to.include(\"/oauth2/authorize\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Exchange code for tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth2/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth2",
                "token"
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{postman_client_id}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{postman_client_secret}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code",
                  "type": "text"
                },
                {
                  "key": "code",
                  "value": "{{auth_code}}",
                  "type": "text"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirect_uri}}",
                  "type": "text"
                },
                {
                  "key": "code_verifier",
                  "value": "{{code_verifier}}",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.environment.set(\"access_token\", j.access_token);",
                  "if (j.refresh_token) pm.environment.set(\"refresh_token\", j.refresh_token);",
                  "if (j.id_token) pm.environment.set(\"id_token\", j.id_token);",
                  "pm.test(\"access_token returned\", () => pm.expect(j.access_token).to.be.a(\"string\"));",
                  "pm.test(\"id_token returned (openid scope)\", () => pm.expect(j.id_token).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
