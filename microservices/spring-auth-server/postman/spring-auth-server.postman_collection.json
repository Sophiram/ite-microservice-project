    {
      "name": "6 - Order Service to Customer Service (OAuth2 Client Credentials)",
      "item": [
        {
          "name": "6.1 Get Token for order-service (client_credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Returns valid Bearer access token\", () => {",
                  "  pm.expect(json.token_type).to.eql(\"Bearer\");",
                  "  pm.expect(json.access_token).to.be.a(\"string\");",
                  "  pm.expect(json.expires_in).to.be.above(0);",
                  "  pm.expect(json.scope).to.include(\"customer.read\");",
                  "});",
                  "pm.environment.set(\"order_access_token\", json.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{order_client_id}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{order_client_secret}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "customer.read business.read",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/oauth2/token",
              "host": ["{{baseUrl}}"],
              "path": ["oauth2", "token"]
            }
          }
        },
        {
          "name": "6.2 Direct Call Customer Service WITH Token (Expect 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is an array of customers\", () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{order_access_token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{customer_service_url}}/api/customers",
              "host": ["{{customer_service_url}}"],
              "path": ["api", "customers"]
            }
          }
        },
        {
          "name": "6.3 Direct Call Customer Service WITHOUT Token (Expect 401)",
          "event": [
