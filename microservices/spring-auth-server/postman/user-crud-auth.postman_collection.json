{
  "info": {
    "name": "Spring Auth Server - User CRUD & Auth",
    "description": "Collection for testing User Registration, Login, and full User CRUD on Spring Authorization Server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9000",
      "type": "string"
    },
    {
      "key": "testUserId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0 - Health Check",
      "item": [
        {
          "name": "Public Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/ping",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "ping"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status is ok\", () => {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 - Authentication",
      "item": [
        {
          "name": "1.1 Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\",\n  \"email\": \"testuser@example.com\",\n  \"roles\": [\"USER\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test(\"User registered with valid ID\", () => {",
                  "  pm.expect(res.id).to.be.a(\"number\");",
                  "  pm.expect(res.username).to.eql(\"testuser\");",
                  "  pm.collectionVariables.set(\"testUserId\", res.id.toString());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Login with Registered User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"Login successful\", () => {",
                  "  pm.expect(res.message).to.eql(\"Login successful\");",
                  "  pm.expect(res.username).to.eql(\"testuser\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Login with Pre-seeded Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"Admin has ADMIN role\", () => {",
                  "  pm.expect(res.roles).to.include(\"ADMIN\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Login with Wrong Password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - User Management (CRUD)",
      "item": [
        {
          "name": "2.1 Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"clark_kent\",\n  \"password\": \"superman123\",\n  \"email\": \"clark@dailyplanet.com\",\n  \"roles\": [\"USER\", \"HERO\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test(\"User created\", () => {",
                  "  pm.expect(res.id).to.be.a(\"number\");",
                  "  pm.expect(res.username).to.eql(\"clark_kent\");",
                  "  pm.collectionVariables.set(\"testUserId\", res.id.toString());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"Returns an array of users\", () => {",
                  "  pm.expect(res).to.be.an(\"array\");",
                  "  pm.expect(res.length).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{testUserId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"Fetched correct user\", () => {",
                  "  pm.expect(res.id.toString()).to.eql(pm.collectionVariables.get(\"testUserId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superman@justiceleague.org\",\n  \"enabled\": true,\n  \"roles\": [\"USER\", \"HERO\", \"LEADER\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{testUserId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"User updated successfully\", () => {",
                  "  pm.expect(res.email).to.eql(\"superman@justiceleague.org\");",
                  "  pm.expect(res.roles).to.include(\"LEADER\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{testUserId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 204 No Content\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 Verify User Deleted (expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{testUserId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
