SERVER_PORT=9000
SPRING_APPLICATION_NAME=iam-service
DB_URL=jdbc:postgresql://localhost:9543/iam
DB_USERNAME=yourdb
DB_PASSWORD=yourpassword
DB_DRIVER=org.postgresql.Driver
JPA_DDL_AUTO=none
OAUTH2_ISSUER_URI=http://localhost:9000

# Set this to a BCrypt hash before first startup so the seeded administrator can sign in.
IAM_ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# OAuth provider credentials from each provider's developer console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# DCR client secret is required to seed the client.create/client.read client.
IAM_DCR_CLIENT_ID=iam-dcr
IAM_DCR_CLIENT_SECRET=replace-with-a-long-random-secret
IAM_BROWSER_CLIENT_ID=iam-browser
IAM_BROWSER_REDIRECT_URI=https://oauth.pstmn.io/v1/callback
